FROM python:3.11-slim

# Install FFmpeg — required for actual transcoding, same as Dockerfile.local
RUN apt-get update && \
    apt-get install -y ffmpeg && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# Run as non-root — matches the security posture of the distroless:nonroot
# base your Go services use. EKS nodes are shared across pods, so no
# container should run as root unless it truly needs to.
RUN useradd --create-home --uid 1000 appuser
USER appuser

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8092"]