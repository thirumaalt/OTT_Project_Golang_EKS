FROM golang:1.22 AS builder
WORKDIR /app
COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    GOFLAGS=-mod=mod go build -ldflags="-s -w" -o devops-dashboard-service .

# distroless — has CA certs needed for AWS API calls (IRSA/STS) and the
# GitHub API's TLS connection. Same base every other Go service in this
# project uses.
FROM gcr.io/distroless/static:nonroot
COPY --from=builder /app/devops-dashboard-service /devops-dashboard-service
ENTRYPOINT ["/devops-dashboard-service"]
