pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir('auth-service') {
                    withSonarQubeEnv('SonarQube') {
                        script {
                            def scannerHome = tool(
                                name: 'SonarQubeScanner',
                                type: 'hudson.plugins.sonar.SonarRunnerInstallation'
                            )

                            sh """
                                ${scannerHome}/bin/sonar-scanner \
                                -Dsonar.projectKey=myflix-auth-service \
                                -Dsonar.projectName=myflix-auth-service \
                                -Dsonar.sources=.
                            """
                        }
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Trivy Filesystem Scan') {
            steps {
                container('trivy') {
                    dir('auth-service') {
                        sh '''
                            echo "========================================"
                            echo "TRIVY FILESYSTEM SCAN"
                            echo "========================================"

                            trivy fs \
                                --scanners vuln \
                                --severity HIGH,CRITICAL \
                                --format table \
                                --output trivy-console.txt \
                                .

                            TRIVY_EXIT_CODE=$?

                            echo ""
                            echo "========================================"
                            echo "TRIVY RESULT"
                            echo "========================================"

                            cat trivy-console.txt

                            echo ""
                            echo "Trivy exit code: ${TRIVY_EXIT_CODE}"

                            exit ${TRIVY_EXIT_CODE}
                        '''
                    }
                }
            }

            post {
                always {
                    archiveArtifacts(
                        artifacts: 'auth-service/trivy-console.txt',
                        allowEmptyArchive: true
                    )
                }
            }
        }

        stage('Docker Build & Push') {
            steps {
                container('kaniko') {
                    withCredentials([
                        usernamePassword(
                            credentialsId: 'dockerhub-creds',
                            usernameVariable: 'DOCKER_USERNAME',
                            passwordVariable: 'DOCKER_PASSWORD'
                        )
                    ]) {
                        sh '''
                            set -e

                            echo "========================================"
                            echo "DOCKER BUILD & PUSH"
                            echo "========================================"

                            test -f "${WORKSPACE}/auth-service/Dockerfile"
                            test -f "${WORKSPACE}/auth-service/go.mod"

                            mkdir -p /kaniko/.docker

                            AUTH=$(printf "%s:%s" "$DOCKER_USERNAME" "$DOCKER_PASSWORD" | base64 | tr -d '\\n')

                            printf '{"auths":{"https://index.docker.io/v1/":{"auth":"%s"}}}' "$AUTH" \
                                > /kaniko/.docker/config.json

                            IMAGE="thiru98/myflix-auth-service:${BUILD_NUMBER}"

                            echo "Building: ${IMAGE}"

                            /kaniko/executor \
                                --context "${WORKSPACE}/auth-service" \
                                --dockerfile "${WORKSPACE}/auth-service/Dockerfile" \
                                --destination "${IMAGE}" \
                                --cache=true

                            echo "Docker image pushed successfully: ${IMAGE}"
                        '''
                    }
                }
            }
        }

        stage('Trivy Image Scan') {
            steps {
                container('trivy') {
                    withCredentials([
                        usernamePassword(
                            credentialsId: 'dockerhub-creds',
                            usernameVariable: 'DOCKER_USERNAME',
                            passwordVariable: 'DOCKER_PASSWORD'
                        )
                    ]) {
                        sh '''
                            set +e

                            IMAGE="thiru98/myflix-auth-service:${BUILD_NUMBER}"

                            echo "========================================"
                            echo "TRIVY IMAGE SCAN"
                            echo "========================================"

                            trivy image \
                                --username "$DOCKER_USERNAME" \
                                --password "$DOCKER_PASSWORD" \
                                --scanners vuln \
                                --severity HIGH,CRITICAL \
                                --format table \
                                --output trivy-image-console.txt \
                                "$IMAGE"

                            TRIVY_EXIT_CODE=$?

                            cat trivy-image-console.txt

                            echo ""
                            echo "Trivy image exit code: ${TRIVY_EXIT_CODE}"

                            exit ${TRIVY_EXIT_CODE}
                        '''
                    }
                }
            }

            post {
                always {
                    archiveArtifacts(
                        artifacts: 'auth-service/trivy-image-console.txt',
                        allowEmptyArchive: true
                    )
                }
            }
        }
    }

    post {
        success {
            echo "CI pipeline completed successfully."
        }

        failure {
            echo "CI pipeline failed."
        }

        always {
            echo "Build Number: ${BUILD_NUMBER}"
        }
    }
}