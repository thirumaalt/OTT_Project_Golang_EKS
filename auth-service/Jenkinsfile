pipeline {

    agent any

    environment {
        DOCKER_IMAGE = 'thiru98/myflix-auth-service'
        IMAGE_TAG = "${BUILD_NUMBER}"
    }

    stages {

        // ============================================================
        // 1. CHECKOUT
        // ============================================================
        stage('Checkout') {
            steps {

                echo '========================================'
                echo '           CHECKOUT SOURCE CODE'
                echo '========================================'

                checkout scm

                sh '''
                    echo "Workspace:"
                    pwd

                    echo ""
                    echo "Auth-service directory:"
                    ls -la auth-service

                    echo ""
                    echo "Checking required files..."

                    test -f auth-service/Dockerfile
                    test -f auth-service/go.mod

                    echo "Dockerfile found."
                    echo "go.mod found."
                '''
            }
        }


        // ============================================================
        // 2. SONARQUBE ANALYSIS
        // ============================================================
        stage('SonarQube Analysis') {
            steps {

                echo '========================================'
                echo '          SONARQUBE ANALYSIS'
                echo '========================================'

                dir('auth-service') {

                    withSonarQubeEnv('SonarQube') {

                        script {

                            def scannerHome = tool(
                                name: 'SonarQubeScanner',
                                type: 'hudson.plugins.sonar.SonarRunnerInstallation'
                            )

                            sh """
                                ${scannerHome}/bin/sonar-scanner \
                                -Dsonar.projectKey=myflix-auth-service \
                                -Dsonar.projectName=myflix-auth-service \
                                -Dsonar.sources=. \
                                -Dsonar.tests=. \
                                -Dsonar.test.inclusions=**/*_test.go
                            """
                        }
                    }
                }
            }
        }


        // ============================================================
        // 3. SONARQUBE QUALITY GATE
        // ============================================================
        stage('Quality Gate') {
            steps {

                echo '========================================'
                echo '        SONARQUBE QUALITY GATE'
                echo '========================================'

                timeout(time: 10, unit: 'MINUTES') {

                    waitForQualityGate abortPipeline: true
                }
            }
        }


        // ============================================================
        // 4. TRIVY FILESYSTEM SCAN
        // ============================================================
        stage('Trivy Security Scan') {
            steps {

                container('trivy') {

                    sh '''
                        set +e

                        echo "========================================"
                        echo "       TRIVY FILESYSTEM SCAN"
                        echo "========================================"

                        cd "${WORKSPACE}/auth-service"

                        echo ""
                        echo "Scanning directory:"
                        pwd

                        echo ""
                        echo "Generating HTML report..."

                        trivy fs \
                            --scanners vuln \
                            --severity HIGH,CRITICAL \
                            --format template \
                            --template "@/contrib/html.tpl" \
                            --output "${WORKSPACE}/trivy-report.html" \
                            .

                        echo ""
                        echo "Generating console report..."

                        trivy fs \
                            --scanners vuln \
                            --severity HIGH,CRITICAL \
                            --format table \
                            --output "${WORKSPACE}/trivy-console.txt" \
                            .

                        echo ""
                        echo "========================================"
                        echo "       TRIVY VULNERABILITY SUMMARY"
                        echo "========================================"

                        cat "${WORKSPACE}/trivy-console.txt"

                        echo ""
                        echo "========================================"
                        echo "             REPORT FILES"
                        echo "========================================"

                        ls -lh "${WORKSPACE}/trivy-report.html"
                        ls -lh "${WORKSPACE}/trivy-console.txt"

                        exit 0
                    '''
                }
            }

            post {

                always {

                    echo '========================================'
                    echo '       PUBLISHING TRIVY REPORT'
                    echo '========================================'

                    publishHTML([
                        allowMissing: true,
                        alwaysLinkToLastBuild: true,
                        keepAll: true,
                        reportDir: '.',
                        reportFiles: 'trivy-report.html',
                        reportName: 'Trivy Vulnerability Report',
                        reportTitles: 'HIGH & CRITICAL Vulnerabilities'
                    ])

                    archiveArtifacts(
                        artifacts: 'trivy-report.html,trivy-console.txt',
                        allowEmptyArchive: true,
                        fingerprint: true
                    )
                }
            }
        }


        // ============================================================
        // 5. TRIVY SECURITY GATE
        // ============================================================
        stage('Trivy Security Gate') {
            steps {

                container('trivy') {

                    sh '''
                        set +e

                        echo "========================================"
                        echo "        TRIVY SECURITY GATE"
                        echo "========================================"

                        cd "${WORKSPACE}/auth-service"

                        echo ""
                        echo "Checking HIGH and CRITICAL vulnerabilities..."
                        echo ""

                        trivy fs \
                            --scanners vuln \
                            --severity HIGH,CRITICAL \
                            --exit-code 1 \
                            --format table \
                            .

                        RESULT=$?

                        echo ""
                        echo "========================================"

                        if [ "$RESULT" -eq 0 ]; then

                            echo "   SECURITY GATE: PASSED"
                            echo "   No HIGH/CRITICAL vulnerabilities found."

                        else

                            echo "   SECURITY GATE: FAILED"
                            echo "   HIGH/CRITICAL vulnerabilities detected."
                            echo ""
                            echo "   Open the Trivy Vulnerability Report"
                            echo "   from the Jenkins build."

                        fi

                        echo "========================================"

                        exit "$RESULT"
                    '''
                }
            }
        }


        // ============================================================
        // 6. DOCKER BUILD & PUSH
        // ============================================================
        stage('Docker Build & Push') {
            steps {

                container('kaniko') {

                    withCredentials([
                        usernamePassword(
                            credentialsId: 'dockerhub-creds',
                            usernameVariable: 'DOCKER_USERNAME',
                            passwordVariable: 'DOCKER_PASSWORD'
                        )
                    ]) {

                        sh '''
                            set -e

                            echo "========================================"
                            echo "       DOCKER BUILD & PUSH"
                            echo "========================================"

                            echo ""
                            echo "Workspace:"
                            pwd

                            echo ""
                            echo "Docker image:"
                            echo "${DOCKER_IMAGE}:${IMAGE_TAG}"

                            echo ""
                            echo "========================================"
                            echo "       CHECKING BUILD FILES"
                            echo "========================================"

                            echo ""
                            echo "Dockerfile:"
                            ls -lh "${WORKSPACE}/auth-service/Dockerfile"

                            echo ""
                            echo "go.mod:"
                            ls -lh "${WORKSPACE}/auth-service/go.mod"

                            echo ""
                            echo "========================================"
                            echo "       DOCKER HUB AUTHENTICATION"
                            echo "========================================"

                            mkdir -p /kaniko/.docker

                            AUTH=$(printf '%s:%s' \
                                "$DOCKER_USERNAME" \
                                "$DOCKER_PASSWORD" | \
                                base64 | \
                                tr -d '\\n')

                            printf '{"auths":{"https://index.docker.io/v1/":{"auth":"%s"}}}' "$AUTH" \
                                > /kaniko/.docker/config.json

                            echo "Docker Hub authentication configured."

                            echo ""
                            echo "Docker config:"
                            test -f /kaniko/.docker/config.json

                            echo "Authentication file created."

                            echo ""
                            echo "========================================"
                            echo "          STARTING KANIKO"
                            echo "========================================"

                            echo ""
                            echo "Context:"
                            echo "${WORKSPACE}/auth-service"

                            echo ""
                            echo "Dockerfile:"
                            echo "${WORKSPACE}/auth-service/Dockerfile"

                            echo ""
                            echo "Destination:"
                            echo "${DOCKER_IMAGE}:${IMAGE_TAG}"

                            echo ""

                            /kaniko/executor \
                                --context "${WORKSPACE}/auth-service" \
                                --dockerfile "${WORKSPACE}/auth-service/Dockerfile" \
                                --destination "${DOCKER_IMAGE}:${IMAGE_TAG}" \
                                --cache=true

                            echo ""
                            echo "========================================"
                            echo "       IMAGE PUSH SUCCESSFUL"
                            echo "========================================"

                            echo ""
                            echo "Docker image:"
                            echo "${DOCKER_IMAGE}:${IMAGE_TAG}"

                            echo ""
                            echo "Docker Hub:"
                            echo "https://hub.docker.com/r/thiru98/myflix-auth-service"
                        '''
                    }
                }
            }
        }


        // ============================================================
        // 7. TRIVY IMAGE SCAN
        // ============================================================
        stage('Trivy Image Scan') {
            steps {

                container('trivy') {

                    sh '''
                        set +e

                        echo "========================================"
                        echo "         TRIVY IMAGE SCAN"
                        echo "========================================"

                        echo ""
                        echo "Image:"
                        echo "${DOCKER_IMAGE}:${IMAGE_TAG}"

                        echo ""
                        echo "Scanning image..."

                        trivy image \
                            --severity HIGH,CRITICAL \
                            --format table \
                            --output "${WORKSPACE}/trivy-image-console.txt" \
                            "${DOCKER_IMAGE}:${IMAGE_TAG}"

                        RESULT=$?

                        echo ""
                        echo "========================================"
                        echo "       IMAGE SCAN RESULT"
                        echo "========================================"

                        cat "${WORKSPACE}/trivy-image-console.txt"

                        echo ""
                        echo "Image scan completed."

                        exit 0
                    '''
                }
            }

            post {

                always {

                    archiveArtifacts(
                        artifacts: 'trivy-image-console.txt',
                        allowEmptyArchive: true,
                        fingerprint: true
                    )
                }
            }
        }
    }


    // ================================================================
    // POST ACTIONS
    // ================================================================
    post {

        success {

            echo """
========================================
       PIPELINE SUCCESS
========================================

Build Number:
${BUILD_NUMBER}

Docker Image:
${DOCKER_IMAGE}:${IMAGE_TAG}

SonarQube       : PASSED
Quality Gate    : PASSED
Trivy FS        : PASSED
Docker Build    : PASSED
Docker Push     : PASSED
Trivy Image     : COMPLETED

========================================
"""
        }

        failure {

            echo """
========================================
       PIPELINE FAILED
========================================

Build Number:
${BUILD_NUMBER}

Docker Image:
${DOCKER_IMAGE}:${IMAGE_TAG}

Check the failed stage.

If Trivy failed:
Open:

Trivy Vulnerability Report

from the Jenkins build page.

========================================
"""
        }

        always {

            echo """
========================================
       BUILD INFORMATION
========================================

Build Number:
${BUILD_NUMBER}

Docker Image:
${DOCKER_IMAGE}:${IMAGE_TAG}

========================================
"""
        }
    }
}